# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://miniai:miniai@localhost:5432/miniai
TEST_DATABASE_URL=postgresql+asyncpg://miniai:miniai@localhost:5432/miniai_test

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- API key vault encryption ---
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=replace-with-a-generated-fernet-key

# --- OAuth (phase 1b — leave blank until then) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- System-owned provider key (NOT user BYOK) ---
# Used only for background chat-title generation via Groq Llama-70B.
# If unset, title generation falls back to a truncated first-message title.
MINIAI_SYSTEM_GROQ_API_KEY=replace-with-your-own-groq-key

# System-owned Tavily key -- fallback for web search / deep research when a
# user has no Tavily key of their own in the vault (BYOK is optional for Tavily).
MINIAI_SYSTEM_TAVILY_API_KEY=replace-with-your-own-tavily-key

# --- Background jobs ---
REDIS_URL=redis://localhost:6379

# Only needed to run scripts/smoke_test_live.py manually
SMOKE_GOOGLE_AI_STUDIO_KEY=
